<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Jellyfin.Plugin.AbyssTheme</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.AbyssTheme</RootNamespace>
    <Version>0.3.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.3.0" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="Web/abyss.css" />
    <EmbeddedResource Include="Web/abyss-je.css" />
    <EmbeddedResource Include="Web/abyss-mbe.css" />
    <EmbeddedResource Include="Web/config.html" />
    <EmbeddedResource Include="Web/client.js" />
    <EmbeddedResource Include="Web/config.js" />
    <EmbeddedResource Include="Web/config.css" />
    <EmbeddedResource Include="Web/abyss-lite.css" />
    <EmbeddedResource Include="Web/spotlight.html" />
    <EmbeddedResource Include="Web/spotlight.css" />
    <EmbeddedResource Include="../third-party/Abyss-LICENSE.txt" LogicalName="Abyss.LICENSE" />
  </ItemGroup>
</Project>
